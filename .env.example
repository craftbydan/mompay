# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side only, never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App passwords (client-side, VITE_ prefix is intentional here)
VITE_ME_PASSWORD=your-dashboard-password
VITE_MOM_PASSWORD=your-mom-password

# OpenAI — server-side only (OCR + merchant fallback). Optional: OPENAI_OCR_MODEL=gpt-5-nano
OPENAI_API_KEY=sk-...
# OPENAI_OCR_MODEL=gpt-5-nano
# OPENAI_NORMALIZE_MODEL=gpt-5-nano

# After mom approves the report, show a button that opens your bank / PromptPay / payment page (https, or http for local testing only).
